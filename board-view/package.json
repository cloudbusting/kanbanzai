{
  "name": "kanbanzai-board",
  "displayName": "Kanbanzai Board",
  "description": "The project's Kanbanzai board as a compact kanban in an editor tab. Read-only.",
  "version": "0.6.0",
  "publisher": "cloudbusting",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudbusting/kanbanzai.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:.kanbanzai/config.toml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kanbanzai.showBoard",
        "title": "Kanbanzai: Show Board"
      }
    ],
    "configuration": {
      "title": "Kanbanzai",
      "properties": {
        "kanbanzai.command": {
          "type": "string",
          "default": "",
          "description": "The kanbanzai command to run: an absolute path, or empty for kanbanzai on PATH.",
          "scope": "machine"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The board runs the kanbanzai command in the workspace."
    }
  }
}
