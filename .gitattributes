# Keep the working tree's bytes the same on every OS. The command embeds templates/card.md, and a Windows checkout
# must not turn it into CRLF.
* text=auto
*.go text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
LICENSE text eol=lf
